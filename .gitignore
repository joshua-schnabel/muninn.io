/target/
# Cargo.lock is committed for reproducible builds (binary crate)

# secrets — never commit tokens, keys or credentials
secrets/
*.token
*.pem
*.key
.env

# local, uncommitted config: `muninn.yaml` is what an operator writes for their
# own host, `*.local.yaml` is scratch. The shipped examples in config/ are
# `muninn.example.yaml` / `muninn.minimal.yaml` / `muninn.integration.yaml`.
/config/muninn.yaml
*.local.yaml

# fixture scratch — scripts/fixtures/ holds the committed builders, but the
# rootfs snapshots and apt caches they produce are large and machine-specific
/.fixtures/

# personal Claude Code settings; .claude/settings.json is the shared one and is
# committed
.claude/settings.local.json

# local integration-test scratch directory
/temp-int/

# coverage output — `cargo cov-ci` writes this and CI uploads it from the run
# that produced it, so a committed copy could only ever be stale
/lcov.info
